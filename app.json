{
  "expo": {
    "name": "栗刻 LICO",
    "slug": "lico",
    "scheme": "lico",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "web"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F0"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许栗刻访问相册，用于添加菜谱和步骤图片。"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8764D"
        }
      ],
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "com.dormiveglia.lico",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "栗刻 LICO",
      "shortName": "栗刻",
      "themeColor": "#FFF9F0",
      "backgroundColor": "#FFF9F0",
      "display": "standalone"
    },
    "extra": {
      "eas": {
        "projectId": "c4ba69fc-6f2d-4cab-af50-86ae3e007101"
      }
    },
    "owner": "dormiveglia"
  }
}
